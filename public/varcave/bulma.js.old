class BulmaTabs {
    constructor(selector) {
        //
    }

    init($selector, $activeTab) {
        const $tabs = $($selector).find('li');

        // Si un activeTab est fourni, on l'active, sinon premier tab
        let $targetTab;
        if ($activeTab) {
            $targetTab = $tabs.filter(`[data-tab="${$activeTab}"]`);
        } else {
            $targetTab = $tabs.first();
        }

        // Active le tab choisi
        $tabs.removeClass('is-active');
        $targetTab.addClass('is-active');

        // Affiche le contenu associé, cache les autres
        $('#tabs-contents .tab-content').removeClass('is-active').hide();
        const targetId = $targetTab.data('tab');
        $(`#${targetId}`).addClass('is-active').show();

        // Gestion du clic sur les tabs
        $tabs.on('click', (e) => {
            e.preventDefault();
            const $clicked = $(e.currentTarget);
            const clickedId = $clicked.data('tab');

            $tabs.removeClass('is-active');
            $clicked.addClass('is-active');

            $('#tabs-contents .tab-content').removeClass('is-active').hide();
            $(`#${clickedId}`).addClass('is-active').show();
        });
    }
}